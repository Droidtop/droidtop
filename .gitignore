# Gradle / Android
.gradle/
.kotlin/
build/
*/build/
local.properties
.cxx/
captures/
*.apk
*.aab

# Android Studio / IntelliJ
.idea/
*.iml
.navigation/

# NDK
.externalNativeBuild/

# Cross-compiled native deps (build-scripts/build-vendor-deps.sh output) —
# regenerable, arch-specific, not source. jniLibs/*.so under host-bridge is
# where that script copies its result for Gradle to package; regenerate
# with the script rather than committing prebuilt binaries.
.vendor-deps-build/
host-bridge/src/main/jniLibs/
runtime-linux-root/src/main/assets/bin/

# Signing (real release key + passwords — never commit these; CI reads
# them from repo secrets instead, see .github/workflows/android-build.yml)
.signing/

# shell-default's framework-prebuilt jars (SystemUI-core, plugin core,
# animation lib, msdl, aconfig flags, ~200MB+) — fetched from
# github.com/alesimula/old-resources-m-launcher at build time, not
# committed source; see build-scripts/fetch-shell-default-prebuilts.sh.
shell-default/prebuilts/

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/

# Local Claude Code tooling config, not project source
.claude/
