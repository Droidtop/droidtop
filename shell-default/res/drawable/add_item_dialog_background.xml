<?xml version="1.0" encoding="utf-8"?>
<!-- Pre-28 fallback for res/drawable-v28/: ?android:attr/dialogCornerRadius
     is an API-28 theme attribute, and below that the reference does not
     resolve, so inflating the add-item confirmation sheet throws. This
     fork already carries the same value as its own @dimen/dialogCornerRadius
     (res/values/dimens.xml), which is what the platform attribute resolves
     to on a stock device anyway. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle" >
    <solid android:color="?attr/widgetPickerPrimarySurfaceColor" />
    <corners
        android:topLeftRadius="@dimen/dialogCornerRadius"
        android:topRightRadius="@dimen/dialogCornerRadius" />
</shape>
