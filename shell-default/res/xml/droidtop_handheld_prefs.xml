<?xml version="1.0" encoding="utf-8"?>
<!--
     Handheld-mode preferences (dev.droidtop.shell.gamepad.GamepadShell,
     :app). Lives in :shell-default alongside every other mode's settings so
     the settings surface stays one consistent place, not split per-shell;
     see shell-default/src/app/murinelauncher/settings/SettingsHandheldFragment.kt
     and docs/SPEC.md's settings-architecture note.
-->
<androidx.preference.PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <!-- Real, deliberate absence: "Global settings" used to be a plain
         row right here, which read as though it belonged to Handheld's
         own settings (this screen's own real title) when it's actually
         a totally separate, droidtop-wide destination. It's a real,
         persistent action-bar item on every SettingsActivity screen now
         instead (see SettingsActivity.java's own onCreateOptionsMenu),
         genuinely separate from and shown above whichever shell's
         settings happen to be on screen. -->
    <ListPreference
        android:key="pref_handheld_default_section"
        android:title="@string/pref_handheld_default_section_title"
        android:summary="%s"
        android:entries="@array/pref_handheld_default_section_entries"
        android:entryValues="@array/pref_handheld_default_section_values"
        android:defaultValue="games"
        android:persistent="true" />

    <SwitchPreferenceCompat
        android:key="pref_handheld_show_hints"
        android:title="@string/pref_handheld_show_hints_title"
        android:summary="@string/pref_handheld_show_hints_desc"
        android:defaultValue="true"
        android:persistent="true" />

    <Preference
        android:key="pref_handheld_console_systems"
        android:title="@string/pref_handheld_console_systems_title"
        android:summary="@string/pref_handheld_console_systems_desc" />

    <!-- Re-entry into onboarding's own game-folder picker: see
         SettingsHandheldFragment.kt's own PREF_GAME_FOLDERS handling. -->
    <Preference
        android:key="pref_handheld_game_folders"
        android:title="@string/pref_handheld_game_folders_title"
        android:summary="@string/pref_handheld_game_folders_desc" />

    <!-- A real, working Compose-only action (a live library rescan) that
         only exists inside GamepadShell's own composition, reached the
         same way Console systems/Game folders above are: launch :app's
         MainActivity by explicit component name with a real Intent extra
         it reads on create. See SettingsHandheldFragment.kt. -->
    <Preference
        android:key="pref_handheld_rescan_library"
        android:title="@string/pref_handheld_rescan_library_title"
        android:summary="@string/pref_handheld_rescan_library_desc" />

    <!-- Real, direct preferences: dev.droidtop.library.theme.ThemeAssets/
         ThemePrefs/ThemeDownloader (:runtime-common) are read/written
         directly here, no bounce out to a differently-styled Compose
         screen for the two most common theme actions. entries/entryValues
         for pref_handheld_theme are set dynamically in
         SettingsHandheldFragment.kt (real discovered themes, not a
         compiled-in list; see ThemeAssets.discoverThemes' own doc
         comment). -->
    <ListPreference
        android:key="pref_handheld_theme"
        android:title="@string/pref_handheld_theme_title"
        android:summary="%s" />

    <Preference
        android:key="pref_handheld_sync_theme_index"
        android:title="@string/pref_handheld_sync_theme_index_title"
        android:summary="@string/pref_handheld_sync_theme_index_desc" />

    <!-- The one deliberate exception left: browsing/downloading a NEW
         theme genuinely needs a real, rich, scrollable list of remote
         entries with screenshot previews, a different interaction
         shape than a flat preference list, not a shortcut around
         building it properly. Still jumps into GamepadShell (the only
         place ThemeBrowserScreen's real Compose UI lives), but directly
         into the browser itself now, not an intermediate Appearance
         sub-screen with only this one item left in it. -->
    <Preference
        android:key="pref_handheld_browse_themes"
        android:title="@string/pref_handheld_browse_themes_title"
        android:summary="@string/pref_handheld_browse_themes_desc" />

    <!-- Separate from pref_grid_size_width_drawer_override (murine_prefs_drawer.xml):
         that one sizes the Standard launcher's own app drawer grid; this
         sizes GamepadShell's Apps tab grid, a different view entirely with
         its own icon size/density needs (see GamepadShell's AppIconGrid). -->
    <app.murinelauncher.widget.CustomSeekBarPreference
        android:key="pref_handheld_apps_grid_columns"
        android:title="@string/pref_handheld_apps_grid_columns_title"
        android:summary="@string/pref_handheld_apps_grid_columns_desc"
        android:min="2"
        android:max="10"
        android:defaultValue="5"
        android:persistent="true"
        app:showIncrementButtons="false"
        app:showTicks="true" />

    <!-- Real shortcuts to the other two shells' own settings: this
         shell's own settings are what's shown first when reached from
         Handheld; these are the way to the others, not the default
         landing point. Real android:fragment navigation, same mechanism
         SettingsActivity's own persistent "Global settings" action-bar
         item ultimately relies on too. -->
    <PreferenceCategory android:title="@string/pref_subcategory_other_shells">
        <Preference
            android:key="pref_handheld_desktop_settings"
            android:title="@string/pref_category_desktop_title"
            android:summary="@string/pref_category_desktop_desc"
            android:fragment="app.murinelauncher.settings.SettingsDesktopFragment" />
        <Preference
            android:key="pref_handheld_standard_settings"
            android:title="@string/pref_standard_settings_title"
            android:summary="@string/pref_standard_settings_desc"
            android:fragment="app.murinelauncher.settings.SettingsRootFragment" />
    </PreferenceCategory>

</androidx.preference.PreferenceScreen>
