<?xml version="1.0" encoding="utf-8"?>
<!--
     Handheld-mode preferences (dev.droidtop.shell.gamepad.GamepadShell,
     :app). Lives in :shell-default alongside every other mode's settings so
     the settings surface stays one consistent place, not split per-shell;
     see shell-default/src/app/murinelauncher/settings/SettingsHandheldFragment.kt
     and docs/SPEC.md's settings-architecture note.
-->
<androidx.preference.PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <ListPreference
        android:key="pref_handheld_default_section"
        android:title="@string/pref_handheld_default_section_title"
        android:summary="%s"
        android:entries="@array/pref_handheld_default_section_entries"
        android:entryValues="@array/pref_handheld_default_section_values"
        android:defaultValue="games"
        android:persistent="true" />

    <SwitchPreferenceCompat
        android:key="pref_handheld_show_hints"
        android:title="@string/pref_handheld_show_hints_title"
        android:summary="@string/pref_handheld_show_hints_desc"
        android:defaultValue="true"
        android:persistent="true" />

    <Preference
        android:key="pref_handheld_console_systems"
        android:title="@string/pref_handheld_console_systems_title"
        android:summary="@string/pref_handheld_console_systems_desc" />

    <!-- Re-entry into onboarding's own game-folder picker -- see
         SettingsHandheldFragment.kt's own PREF_GAME_FOLDERS handling. -->
    <Preference
        android:key="pref_handheld_game_folders"
        android:title="@string/pref_handheld_game_folders_title"
        android:summary="@string/pref_handheld_game_folders_desc" />

    <!-- Separate from pref_grid_size_width_drawer_override (murine_prefs_drawer.xml):
         that one sizes the Standard launcher's own app drawer grid; this
         sizes GamepadShell's Apps tab grid, a different view entirely with
         its own icon size/density needs (see GamepadShell's AppIconGrid). -->
    <app.murinelauncher.widget.CustomSeekBarPreference
        android:key="pref_handheld_apps_grid_columns"
        android:title="@string/pref_handheld_apps_grid_columns_title"
        android:summary="@string/pref_handheld_apps_grid_columns_desc"
        android:min="2"
        android:max="10"
        android:defaultValue="5"
        android:persistent="true"
        app:showIncrementButtons="false"
        app:showTicks="true" />

</androidx.preference.PreferenceScreen>
