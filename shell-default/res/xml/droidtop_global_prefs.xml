<?xml version="1.0" encoding="utf-8"?>
<!--
     Real droidtop-wide preferences: config that affects the whole app,
     or things outside any single shell's own UI entirely, not any one
     shell's own settings (Standard/Desktop/Handheld each have their own
     real screen for that, see this same res/xml/ directory). Lives in
     :shell-default alongside every other settings screen; see
     shell-default/src/app/murinelauncher/settings/SettingsGlobalFragment.kt
     and docs/SPEC.md's settings-architecture note.

     Deliberately does NOT link back out to Standard/Desktop/Handheld's own
     settings screens: each of those already links here (and to their
     siblings), and linking both ways would just be a redundant loop, since
     this screen isn't itself a hub between the three shells.
-->
<androidx.preference.PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <!-- Real, existing HomeRolePrefs (dev.droidtop.shell.standard), never
         exposed as a user-facing preference before now: only ever set
         once, during onboarding. Non-persistent: the real, current state
         is HomeRolePrefs.activeHomeImplementation() itself (PackageManager
         component-enabled state), not a separately-tracked SharedPreferences
         value that could drift from it; see SettingsGlobalFragment.kt's
         own PREF_HOME_ROLE handling. -->
    <SwitchPreferenceCompat
        android:key="pref_global_home_role"
        android:title="@string/pref_global_home_role_title"
        android:summary="@string/pref_global_home_role_desc"
        android:persistent="false" />

    <PreferenceCategory android:title="@string/pref_subcategory_modes">

        <!-- Real, dynamic entries (only currently-enabled modes),
             see SettingsGlobalFragment.refreshDefaultModeChoices. -->
        <ListPreference
            android:key="pref_global_default_mode"
            android:title="@string/pref_global_default_mode_title"
            android:summary="@string/pref_global_default_mode_desc"
            android:persistent="false" />

        <SwitchPreferenceCompat
            android:key="pref_global_enable_desktop"
            android:title="@string/pref_global_enable_desktop_title"
            android:summary="@string/pref_global_enable_desktop_desc"
            android:persistent="false" />

        <SwitchPreferenceCompat
            android:key="pref_global_enable_handheld"
            android:title="@string/pref_global_enable_handheld_title"
            android:summary="@string/pref_global_enable_handheld_desc"
            android:persistent="false" />

    </PreferenceCategory>

    <PreferenceCategory android:title="@string/pref_subcategory_data">

        <Preference
            android:key="pref_global_rerun_onboarding"
            android:title="@string/pref_global_rerun_onboarding_title"
            android:summary="@string/pref_global_rerun_onboarding_desc" />

        <Preference
            android:key="pref_global_backup"
            android:title="@string/pref_global_backup_title"
            android:summary="@string/pref_global_backup_desc" />

        <Preference
            android:key="pref_global_restore"
            android:title="@string/pref_global_restore_title"
            android:summary="@string/pref_global_restore_desc" />

    </PreferenceCategory>

    <!-- Real Android system Settings, not droidtop's own: genuinely
         outside every shell's own UI. -->
    <Preference
        android:key="pref_global_system_settings"
        android:title="@string/pref_global_system_settings_title"
        android:summary="@string/pref_global_system_settings_desc" />

</androidx.preference.PreferenceScreen>
