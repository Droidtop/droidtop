<?xml version="1.0" encoding="utf-8"?>
<!--
     Desktop-mode preferences (dev.droidtop.shell.desktop.DesktopShell, :app).
     Lives in :shell-default alongside every other mode's settings so the
     settings surface stays one consistent place, not split per-shell; see
     shell-default/src/app/murinelauncher/settings/SettingsDesktopFragment.kt
     and docs/SPEC.md's settings-architecture note.
-->
<androidx.preference.PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <!-- Real cross-link: see droidtop_handheld_prefs.xml's own matching
         entry for why this is real droidtop-wide config, not Standard's
         own launcher preferences. -->
    <Preference
        android:key="pref_desktop_global_settings"
        android:title="@string/pref_global_settings_title"
        android:summary="@string/pref_global_settings_desc"
        android:fragment="app.murinelauncher.settings.SettingsGlobalFragment" />

    <SwitchPreferenceCompat
        android:key="pref_desktop_taskbar_top"
        android:title="@string/pref_desktop_taskbar_top_title"
        android:summary="@string/pref_desktop_taskbar_top_desc"
        android:defaultValue="false"
        android:persistent="true" />

    <!-- Re-entry into onboarding's own DESKTOP_SETUP step (root check +
         distro/compositor picker): see
         SettingsDesktopFragment.kt's own PREF_ROOT_COMPOSITOR_SETUP handling. -->
    <Preference
        android:key="pref_desktop_root_compositor_setup"
        android:title="@string/pref_desktop_root_compositor_setup_title"
        android:summary="@string/pref_desktop_root_compositor_setup_desc" />

    <!-- Real shortcuts to the other two shells' own settings, matching
         droidtop_handheld_prefs.xml's own equivalent category. -->
    <PreferenceCategory android:title="@string/pref_subcategory_other_shells">
        <Preference
            android:key="pref_desktop_handheld_settings"
            android:title="@string/pref_category_handheld_title"
            android:summary="@string/pref_category_handheld_desc"
            android:fragment="app.murinelauncher.settings.SettingsHandheldFragment" />
        <Preference
            android:key="pref_desktop_standard_settings"
            android:title="@string/pref_standard_settings_title"
            android:summary="@string/pref_standard_settings_desc"
            android:fragment="app.murinelauncher.settings.SettingsRootFragment" />
    </PreferenceCategory>

</androidx.preference.PreferenceScreen>
