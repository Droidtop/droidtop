<!-- Pre-31 fallback for res/color-v31/: the @android:color/system_*
     tones this scrim is built from are the dynamic-colour palette,
     which the platform only publishes from API 31. Below that the
     reference does not resolve at all and inflating the scrim throws.
     The replacement is this fork's own copy of the same Material
     role from res/values/colors.xml: upstream's own pre-31
     palette, not a new colour. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:alpha="0.20" android:color="@color/system_surface_variant_light"/>
</selector>
