<manifest xmlns:android="http://schemas.android.com/apk/res/android"
        package="org.pocketworkstation.pckeyboard">

    <uses-permission android:name="android.permission.VIBRATE"/>
    <uses-permission android:name="android.permission.READ_USER_DICTIONARY" />
    <uses-permission android:name="android.permission.WRITE_USER_DICTIONARY" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <uses-feature android:name="android.hardware.faketouch" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <!--
      droidtop patch (not upstream Hacker's Keyboard): dropped
      android:allowBackup (was "true" - :app's own android:allowBackup=
      "false" is the single source of truth, not a per-module opinion),
      android:backupAgent (real manifest-merge conflict against
      shell-default's own LauncherBackupAgent - Android allows exactly
      one per app; LatinIMEBackupAgent just isn't wired to anything yet,
      so dropping it costs nothing right now), android:hardwareAccelerated
      (was "false", conflicting with shell-default's "true" - no known
      reason this module specifically needs software rendering), and the
      Main activity's LAUNCHER intent-filter (droidtop has one app-drawer
      identity; this would have added a stray second "Hacker's Keyboard"
      icon). Main itself is kept - still reachable by explicit Intent -
      just not a launcher entry point.
    -->
    <application android:label="@string/english_ime_name"
            android:restoreAnyVersion="true"
            android:killAfterRestore="false"
            android:icon="@drawable/icon">

        <!--
          android:exported now explicit on every component below (droidtop
          patch - targetSdk 31+ requires it whenever an intent-filter is
          present, a real build error otherwise, not assumed). LatinIME
          itself must stay exported=true: the system's IME framework has
          to be able to bind to it for it to be selectable at all. Every
          settings/preference screen below is exported=false - reachable
          only by droidtop's own explicit intents, not meant for other
          apps to launch.
        -->
        <service android:name="LatinIME"
                android:label="@string/english_ime_name"
                android:exported="true"
                android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data android:name="android.view.im" android:resource="@xml/method" />
        </service>

        <activity android:name="Main" android:label="Hacker's Keyboard" android:exported="false" />

        <activity android:name="LatinIMESettings" android:label="@string/english_ime_settings"
                android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <action android:name="org.pocketworkstation.pckeyboard.SETTINGS"/>
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity android:name="InputLanguageSelection"
                android:label="@string/language_selection_title"
                android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <action android:name="org.pocketworkstation.pckeyboard.INPUT_LANGUAGE_SELECTION"/>
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity android:name="PrefScreenActions"
                android:label="@string/pref_screen_actions_title"
                android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <action android:name="org.pocketworkstation.pckeyboard.PREFS_ACTIONS"/>
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity android:name="PrefScreenView"
                android:label="@string/pref_screen_actions_title"
                android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <action android:name="org.pocketworkstation.pckeyboard.PREFS_VIEW"/>
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity android:name="PrefScreenFeedback"
                android:label="@string/pref_screen_feedback_title"
                android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <action android:name="org.pocketworkstation.pckeyboard.PREFS_FEEDBACK"/>
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
</application>
</manifest>
