<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="16dp" android:orientation="vertical">
        <Button android:id="@+id/main_setup_btn_configure_imes" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/main_setup_configure_imes" />
        <Button android:id="@+id/main_setup_btn_set_ime" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/main_setup_set_ime" />
        <Button android:id="@+id/main_setup_btn_input_lang" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/main_setup_input_lang" />
        <Button android:id="@+id/main_setup_btn_get_dicts" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/title_dictionaries" />
        <Button android:id="@+id/main_setup_btn_settings" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/main_setup_settings" />
        <EditText android:id="@+id/main_setup_edit_test" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:hint="@string/main_setup_test" android:inputType="textMultiLine|textCapSentences" />
        <TextView android:id="@+id/main_description" android:layout_width="match_parent" android:layout_height="wrap_content" />
    </LinearLayout>
</ScrollView>
