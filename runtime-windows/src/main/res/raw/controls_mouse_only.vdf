// droidtop's "Mouse Only" layout (Droidtop/tracker#618 C5), written for droidtop, CC BY 4.0.
// Steam's controller layout format, so Steam loads it as it is.
"controller_mappings"
{
	"version"		"3"
	"revision"		"1"
	"title"		"#title"
	"description"		"#description"
	"creator"		"droidtop"
