<?xml version="1.0" encoding="utf-8"?>
<!-- The Windows runtime's one component: the activity a Windows game is
     seen and played in (docs/SPEC.md 5b). Every other surface is
     droidtop's own. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <application>
        <!-- Where a Windows game is seen and played. The renderer has to
             live in an Activity because handheld launches are placed on the
             configured launch-target display with setLaunchDisplayId, the
             way every other droidtop launch is; a surface inside the shell
             could only appear where the shell already is.

             Its own task affinity, plus NEW_TASK + CLEAR_TOP on the intent,
             so a second launch replaces the running game instead of leaving
             two X servers contending for the same sockets. configChanges
             covers everything a game screen should survive without being
             torn down and rebuilt around a live X server. -->
        <activity
            android:name="dev.droidtop.runtime.windows.WineGameActivity"
            android:exported="false"
            android:taskAffinity=":wine"
            android:resizeableActivity="true"
            android:screenOrientation="userLandscape"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode|density|layoutDirection"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen" />
    </application>
</manifest>
