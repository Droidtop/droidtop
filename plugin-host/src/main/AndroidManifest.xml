<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!--
          Plugin processes (docs/plugin-api.md 5.3). Not exported: only :app
          binds to them, and only :app decides which plugin loads where.

          Full trust: droidtop's own UID, one process per plugin from eight
          slots (:pluginhost and :pluginhost1 to :pluginhost7). Only a plugin
          the person allowed host.full_trust, and an older contract 1 plugin,
          runs here. This is crash containment, not security: a plugin here can
          do anything droidtop's UID can. A plugin that throws, hangs or
          native-crashes takes down its own process, never :app.
        -->
        <service
            android:name="dev.droidtop.pluginhost.PluginRuntimeService"
            android:process=":pluginhost"
            android:exported="false"
            android:isolatedProcess="false" />
        <service android:name="dev.droidtop.pluginhost.FullTrustSlot1" android:process=":pluginhost1" android:exported="false" />
        <service android:name="dev.droidtop.pluginhost.FullTrustSlot2" android:process=":pluginhost2" android:exported="false" />
        <service android:name="dev.droidtop.pluginhost.FullTrustSlot3" android:process=":pluginhost3" android:exported="false" />
        <service android:name="dev.droidtop.pluginhost.FullTrustSlot4" android:process=":pluginhost4" android:exported="false" />
        <service android:name="dev.droidtop.pluginhost.FullTrustSlot5" android:process=":pluginhost5" android:exported="false" />
        <service android:name="dev.droidtop.pluginhost.FullTrustSlot6" android:process=":pluginhost6" android:exported="false" />
        <service android:name="dev.droidtop.pluginhost.FullTrustSlot7" android:process=":pluginhost7" android:exported="false" />

        <!--
          Contained, the default for a contract 2 plugin: an isolated process
          with a random UID of its own, no permissions, no network and no access
          to droidtop's files or shared storage. Everything the plugin does
          beyond its process goes through its broker. From API 29 :app starts
          one instance per plugin with bindIsolatedService; below that the eight
          slots each hold one plugin.
        -->
        <service
            android:name="dev.droidtop.pluginhost.PluginSandboxService"
            android:process=":plugin_sandbox"
            android:exported="false"
            android:isolatedProcess="true" />
        <service android:name="dev.droidtop.pluginhost.PluginSandboxSlot0" android:process=":plugin_sandbox0" android:exported="false" android:isolatedProcess="true" />
        <service android:name="dev.droidtop.pluginhost.PluginSandboxSlot1" android:process=":plugin_sandbox1" android:exported="false" android:isolatedProcess="true" />
        <service android:name="dev.droidtop.pluginhost.PluginSandboxSlot2" android:process=":plugin_sandbox2" android:exported="false" android:isolatedProcess="true" />
        <service android:name="dev.droidtop.pluginhost.PluginSandboxSlot3" android:process=":plugin_sandbox3" android:exported="false" android:isolatedProcess="true" />
        <service android:name="dev.droidtop.pluginhost.PluginSandboxSlot4" android:process=":plugin_sandbox4" android:exported="false" android:isolatedProcess="true" />
        <service android:name="dev.droidtop.pluginhost.PluginSandboxSlot5" android:process=":plugin_sandbox5" android:exported="false" android:isolatedProcess="true" />
        <service android:name="dev.droidtop.pluginhost.PluginSandboxSlot6" android:process=":plugin_sandbox6" android:exported="false" android:isolatedProcess="true" />
        <service android:name="dev.droidtop.pluginhost.PluginSandboxSlot7" android:process=":plugin_sandbox7" android:exported="false" android:isolatedProcess="true" />

        <!--
          A gpu.render plugin: the same broker-only, descriptor-loaded plugin
          as the contained sandbox, but in a process of droidtop's own UID that
          is NOT isolated, so it may open the graphics chip (an isolated process
          may not: sepolicy isolated_app_all.te). That is the one hole the
          gpu.render permission opens. A system-call filter keeps it off the
          network, but it shares droidtop's UID, which an app on Android cannot
          wall off, so its own native code could still open droidtop's files or
          ask Android's services for things as droidtop. The approval line and
          the plugin's page warn about that in plain words (docs/plugin-api.md
          5.3). Eight slots, one plugin each.
        -->
        <service android:name="dev.droidtop.pluginhost.PluginGpuSlot0" android:process=":plugin_gpu0" android:exported="false" android:isolatedProcess="false" />
        <service android:name="dev.droidtop.pluginhost.PluginGpuSlot1" android:process=":plugin_gpu1" android:exported="false" android:isolatedProcess="false" />
        <service android:name="dev.droidtop.pluginhost.PluginGpuSlot2" android:process=":plugin_gpu2" android:exported="false" android:isolatedProcess="false" />
        <service android:name="dev.droidtop.pluginhost.PluginGpuSlot3" android:process=":plugin_gpu3" android:exported="false" android:isolatedProcess="false" />
        <service android:name="dev.droidtop.pluginhost.PluginGpuSlot4" android:process=":plugin_gpu4" android:exported="false" android:isolatedProcess="false" />
        <service android:name="dev.droidtop.pluginhost.PluginGpuSlot5" android:process=":plugin_gpu5" android:exported="false" android:isolatedProcess="false" />
        <service android:name="dev.droidtop.pluginhost.PluginGpuSlot6" android:process=":plugin_gpu6" android:exported="false" android:isolatedProcess="false" />
        <service android:name="dev.droidtop.pluginhost.PluginGpuSlot7" android:process=":plugin_gpu7" android:exported="false" android:isolatedProcess="false" />

        <!--
          A plugin's own full-screen UI (ui.main, docs/plugin-api.md 1.7),
          hosted in a full-trust plugin process: an activity cannot run in an
          isolated process, and only a Flutter plugin, which needs full access
          anyway, can declare one. Not exported: only droidtop starts it, after
          checking approval and the signature. It takes the configuration
          changes itself, as every Flutter activity does.
        -->
        <activity
            android:name="dev.droidtop.pluginhost.PluginMainActivity"
            android:process=":pluginhost"
            android:exported="false"
            android:theme="@android:style/Theme.Black.NoTitleBar"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode" />

        <!--
          A contained plugin's own full-screen UI (ui.main): an isolated
          process has no window, so this activity in droidtop's own process
          owns the surface the plugin draws into, and passes touch and keys
          on (docs/plugin-api.md 1.7, 5.3). Not exported.
        -->
        <activity
            android:name="dev.droidtop.pluginhost.PluginScreenActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Black.NoTitleBar"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|screenLayout|density|uiMode" />

        <!--
          What the broker asks Android for on a plugin's behalf, in droidtop's
          own process and under droidtop's own permissions (docs/plugin-api.md
          3 D4, 4.1): the system file picker for files.pick and Android's
          runtime permission prompt. Never on its own: only during a call the
          person started. Not exported.
        -->
        <!--
          droidtop's own web view: a plugin's signed-in session
          (docs/plugin-api.md 3 G3), a site's sign-in page or a protected
          link whose download droidtop captures, shown only during a call the
          person started, the plugin never seeing the page's cookies; and a
          store's own pages with the account's session (docs/SPEC.md 7g).
          Not exported.
        -->
        <activity
            android:name="dev.droidtop.pluginhost.WebSessionActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation"
            android:theme="@android:style/Theme.Material.NoActionBar" />

        <activity
            android:name="dev.droidtop.pluginhost.BrokerAskActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!--
          Where Shizuku hands droidtop its binder. Shizuku's server looks for a
          provider named "applicationId.shizuku" in every app the user allowed
          and calls sendBinder on it, so the provider has to exist for the
          Shizuku provider plugin to work at all. It lives in :pluginhost, the
          first full-trust slot; every other droidtop process, the other slots
          and droidtop's own main process included, shares the binder through
          Shizuku's multi-process support (ShizukuTransport, SystemShizukuOps).
          Every other plugin reaches privilege through the priv.* APIs.
          The permission is the one Shizuku's own documentation asks for: only
          the Shizuku server (the shell or root) holds it.
        -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:process=":pluginhost"
            android:multiprocess="false"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />
    </application>
</manifest>
