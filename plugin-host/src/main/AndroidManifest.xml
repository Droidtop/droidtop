<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!--
          The plugin sandbox is for compatibility and crash containment,
          NOT security (docs/SPEC.md 12a): this is a same-UID, separate
          PROCESS, not a separate app. A plugin that throws, hangs or
          native-crashes takes down :pluginhost, :app's binder connection
          dies (DeathRecipient), PluginCrashPolicy disables that plugin
          and the launcher keeps running. It is not exported: only :app
          binds to it, and only :app decides which plugin loads.
        -->
        <service
            android:name="dev.droidtop.pluginhost.PluginRuntimeService"
            android:process=":pluginhost"
            android:exported="false"
            android:isolatedProcess="false" />

        <!--
          Where Shizuku hands droidtop its binder. Shizuku's server looks for a
          provider named "applicationId.shizuku" in every app the user allowed
          and calls sendBinder on it, so the provider has to exist for the
          Shizuku provider plugin to work at all. It lives in :pluginhost, the
          process the plugin runs in, so the binder arrives where it is used.
          Only the official Shizuku provider plugin uses it (docs/plugin-api.md
          2.7); every other plugin reaches privilege through the priv.* APIs.
          The permission is the one Shizuku's own documentation asks for: only
          the Shizuku server (the shell or root) holds it.
        -->
        <!--
          A plugin's own full-screen UI (ui.main, docs/plugin-api.md 1.7),
          hosted in the plugin's process. Not exported: only droidtop starts
          it, after checking approval and the signature. It takes the
          configuration changes itself, as every Flutter activity does.
        -->
        <activity
            android:name="dev.droidtop.pluginhost.PluginMainActivity"
            android:process=":pluginhost"
            android:exported="false"
            android:theme="@android:style/Theme.Black.NoTitleBar"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode" />

        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:process=":pluginhost"
            android:multiprocess="false"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />
    </application>
</manifest>
