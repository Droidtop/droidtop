<?xml version="1.0" encoding="utf-8"?>
<!--
  Backs the `dev.droidtop.app.joiplay.fileprovider` authority (JoiPlay.FILE_PROVIDER_AUTHORITY
  in JoiPlayIntegration.kt) so a game executable's File can become a content:// Uri JoiPlay can
  read across the app boundary. Assumes direct filesystem access to wherever game folders live —
  if droidtop's actual game-storage design ends up being SAF-based (ACTION_OPEN_DOCUMENT_TREE,
  the mechanism docs/SPEC.md §7b already uses for ES-DE library sync) instead of a plain external
  storage path, a DocumentFile's own content:// Uri would be used directly and this FileProvider
  wouldn't be needed at all — that design question isn't resolved yet, see §7d.
-->
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <external-path name="external_files" path="." />
    <external-files-path name="app_external_files" path="." />
</paths>
