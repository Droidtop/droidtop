<?xml version="1.0" encoding="utf-8"?>
<!-- droidtop's keyboard for other apps on a screen Android draws no keyboard on
     (TypingAccessibilityService, docs/SPEC.md 4c "Typing on the add-on display").
     Only the events it needs: a view gaining focus or being tapped (a text field
     to type into), and a window changing (the field went away). Interactive
     windows are retrieved because a field's window names its display. Windows
     changing also tells the picture-in-picture mover to look (PipMover). Screenshots
     are the service's second job: the companion's Screenshot row and pin (Capture). The third is the
     companion trackpad's pointer on the main screen: it plays taps, long presses, drags and swipes there
     (canPerformGestures, AccessibilityPointer). The fourth, while droidtop is the default home only, is the HOME
     chords that open droidtop's menus over a game (canRequestFilterKeyEvents, HomeOverlayKeys, Droidtop/tracker#740).
     It is also Standard's: the taskbar's overlay window and keys (StandardTaskbar) and the gesture actions
     (lock screen, Recents), through AccessibilityHost. Those had a second service of their own, deleted in #740. -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeViewFocused|typeViewClicked|typeWindowStateChanged|typeWindowsChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagRetrieveInteractiveWindows"
    android:canRetrieveWindowContent="true"
    android:canPerformGestures="true"
    android:canTakeScreenshot="true"
    android:canRequestFilterKeyEvents="true"
    android:description="@string/typing_accessibility_description"
    android:notificationTimeout="50" />
