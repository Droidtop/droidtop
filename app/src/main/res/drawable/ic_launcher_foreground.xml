<?xml version="1.0" encoding="utf-8"?>
<!-- DroidTop's own icon (not Murine/Launcher3's default): a laptop with the
     Android robot on its screen — "turns an Android device into a laptop-
     class desktop." Kept inside the ~66dp adaptive-icon safe zone (centered
     in the 108x108 viewport) so it survives circle/squircle/rounded-square
     masking alike. Android green (#3DDC84, the real brand color) for the
     robot and screen glow; light grey for the laptop body so it reads
     clearly against the dark background layer. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Laptop base / keyboard deck -->
    <path
        android:fillColor="#CFD8DC"
        android:pathData="M24,76 L84,76 L90,84 L18,84 Z" />

    <!-- Laptop screen bezel -->
    <path
        android:fillColor="#CFD8DC"
        android:pathData="M30,26 h48 a4,4 0 0 1 4,4 v42 a4,4 0 0 1 -4,4 h-48 a4,4 0 0 1 -4,-4 v-42 a4,4 0 0 1 4,-4 z" />

    <!-- Screen (darker inset, robot sits on this) -->
    <path
        android:fillColor="#10151C"
        android:pathData="M34,31 h40 v36 h-40 z" />

    <!-- Android robot: dome head -->
    <path
        android:fillColor="#3DDC84"
        android:pathData="M46,52 a8,8 0 0 1 16,0 z" />

    <!-- Robot antennae -->
    <path
        android:strokeColor="#3DDC84"
        android:strokeWidth="1.6"
        android:strokeLineCap="round"
        android:pathData="M47.3,42.5 l-3,-5.2 M60.7,42.5 l3,-5.2" />

    <!-- Robot body -->
    <path
        android:fillColor="#3DDC84"
        android:pathData="M45,52 h18 v9 a2,2 0 0 1 -2,2 h-14 a2,2 0 0 1 -2,-2 z" />

    <!-- Robot arms -->
    <path
        android:fillColor="#3DDC84"
        android:pathData="M41.5,53 h3 v8 h-3 a1.5,1.5 0 0 1 -1.5,-1.5 v-5 a1.5,1.5 0 0 1 1.5,-1.5 z" />
    <path
        android:fillColor="#3DDC84"
        android:pathData="M63.5,53 h3 a1.5,1.5 0 0 1 1.5,1.5 v5 a1.5,1.5 0 0 1 -1.5,1.5 h-3 z" />

    <!-- Robot legs -->
    <path
        android:fillColor="#3DDC84"
        android:pathData="M49,63 h3 v5 a1.5,1.5 0 0 1 -3,0 z" />
    <path
        android:fillColor="#3DDC84"
        android:pathData="M56,63 h3 v5 a1.5,1.5 0 0 1 -3,0 z" />

    <!-- Eyes (cut out of the dome) -->
    <path
        android:fillColor="#10151C"
        android:pathData="M50.4,48.4 a1.1,1.1 0 1 1 -2.2,0 a1.1,1.1 0 1 1 2.2,0 z" />
    <path
        android:fillColor="#10151C"
        android:pathData="M59.8,48.4 a1.1,1.1 0 1 1 -2.2,0 a1.1,1.1 0 1 1 2.2,0 z" />
</vector>
