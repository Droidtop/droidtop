<resources>
    <!-- Not named app_name: shell-default (forked-in Murine Launcher) also
         defines a string literally named app_name, used broadly throughout
         its own UI text, not just its manifest label. Since it has
         per-locale translations of that name and we don't, non-English
         locales fell back to its value ("Launcher:3") instead of ours for
         the app's display label - confirmed on a real published APK via
         `aapt dump badging`. A distinct name avoids the resource-name
         collision entirely rather than fighting it. -->
    <string name="droidtop_app_name">droidtop</string>
    <!-- The app shortcut on droidtop's icon that opens the games grid (res/xml/shortcuts.xml). -->
    <string name="shortcut_games">Games</string>
    <!-- ContinuePlayingWidgetProvider: home-screen widget title, and its
         empty state before any game has been played. -->
    <string name="widget_continue_playing_title">Continue playing</string>
    <string name="widget_continue_playing_empty">No games played yet</string>
</resources>
