<?xml version="1.0" encoding="utf-8"?>
<!-- droidtop's one launcher-icon "field": every surface that shows
     droidtop's own icon (manifest android:icon/roundIcon, the API 31+
     splash theme, app shortcuts, widget previews, the pinned-shortcut
     fallback, and - via the monochrome layer below - the desktop-session
     notification) references this single alias, mipmap/ic_launcher.
     Swap the three drawables below to replace the art; nothing else
     needs to change. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background"/>
    <foreground android:drawable="@drawable/ic_launcher_foreground"/>
    <monochrome android:drawable="@drawable/ic_launcher_monochrome"/>
</adaptive-icon>
