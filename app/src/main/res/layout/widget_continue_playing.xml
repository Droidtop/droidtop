<?xml version="1.0" encoding="utf-8"?>
<!--
  Fixed-row layout for ContinuePlayingWidgetProvider: a title, up to four
  tap-to-launch rows (one per LibraryEntry, most recently played first),
  and an empty state for a library with no play history yet. Colours are
  the system's own widget background/text (no droidtop ChromeColors
  here): a launcher's home-screen widgets are stock Android surfaces on
  a wallpaper, same as every other app's widget, not droidtop's own
  chrome (docs/SPEC.md 7k scopes that system to droidtop's own chrome).
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_continue_playing_background"
    android:padding="12dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/widget_continue_playing_title"
        android:textStyle="bold"
        android:textSize="14sp"
        android:textColor="@android:color/white"
        android:layout_marginBottom="6dp" />

    <TextView
        android:id="@+id/widget_continue_playing_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/widget_continue_playing_empty"
        android:textSize="13sp"
        android:textColor="#CCFFFFFF"
        android:visibility="gone" />

    <TextView
        android:id="@+id/widget_continue_playing_row1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="36dp"
        android:gravity="center_vertical"
        android:textSize="13sp"
        android:textColor="@android:color/white"
        android:ellipsize="end"
        android:maxLines="1"
        android:clickable="true"
        android:focusable="true" />

    <TextView
        android:id="@+id/widget_continue_playing_row2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="36dp"
        android:gravity="center_vertical"
        android:textSize="13sp"
        android:textColor="@android:color/white"
        android:ellipsize="end"
        android:maxLines="1"
        android:clickable="true"
        android:focusable="true" />

    <TextView
        android:id="@+id/widget_continue_playing_row3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="36dp"
        android:gravity="center_vertical"
        android:textSize="13sp"
        android:textColor="@android:color/white"
        android:ellipsize="end"
        android:maxLines="1"
        android:clickable="true"
        android:focusable="true" />

    <TextView
        android:id="@+id/widget_continue_playing_row4"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="36dp"
        android:gravity="center_vertical"
        android:textSize="13sp"
        android:textColor="@android:color/white"
        android:ellipsize="end"
        android:maxLines="1"
        android:clickable="true"
        android:focusable="true" />

</LinearLayout>
