<?xml version="1.0" encoding="utf-8"?>
<!--
  The Library search widget (LibrarySearchWidgetProvider): one bar that opens droidtop's one search. Colours are set by
  the renderer from the role tokens.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/widget_surface_dark"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:clickable="true"
    android:focusable="true">

    <ImageView
        android:id="@+id/widget_icon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@android:drawable/ic_menu_search"
        android:contentDescription="@null" />

    <TextView
        android:id="@+id/widget_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:text="@string/widget_search_hint"
        android:textSize="16sp"
        android:textColor="#CCFFFFFF"
        android:maxLines="1"
        android:ellipsize="end" />
</LinearLayout>
