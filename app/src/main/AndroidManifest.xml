<manifest
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Secondary-display presentation (second screen / external lapdock monitor) -->
    <uses-feature android:name="android.software.presentation" android:required="false" />

    <application
        android:label="@string/droidtop_app_name"
        android:allowBackup="false"
        android:theme="@style/Theme.DroidTop"
        tools:replace="android:label">

        <!--
          The real HOME/LAUNCHER entry point is :shell-default's own
          com.android.launcher3.Launcher (forked-in Murine Launcher — see
          shell-default/README.md), declared in that library module's own
          manifest and merged in here by AGP. This is deliberately NOT a
          second app-drawer icon: droidtop defaults to the normal Android
          launcher experience, and reaches Desktop/Handheld/Settings via
          the home screen's own back-button menu (see
          dev.droidtop.shell.standard.BackButtonMenu, patched into
          Launcher.onBackPressed()) launching this Activity by explicit
          Intent with an EXTRA_MODE extra — not a separate entry point a
          user would ever tap directly from the app drawer.
        -->
        <activity
            android:name="dev.droidtop.app.MainActivity"
            android:exported="true" />

        <!--
          Runs the primary container's host-bridge session (connect + present
          outputs) as a foreground service so the desktop survives the
          launcher Activity being backgrounded — see docs/SPEC.md.
        -->
        <service
            android:name="dev.droidtop.app.DesktopSessionService"
            android:exported="false"
            android:foregroundServiceType="specialUse" />

    </application>
</manifest>
