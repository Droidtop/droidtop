<manifest
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Secondary-display presentation (second screen / external lapdock monitor) -->
    <uses-feature android:name="android.software.presentation" android:required="false" />

    <!-- DesktopSessionService (below) is a foreground service so the
         primary container's session survives the launching Activity being
         backgrounded. Both permissions are required for a "specialUse"
         foreground service on API 34+; POST_NOTIFICATIONS is required on
         API 33+ for the foreground-service notification itself to show. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Real outbound HTTP: ScreenScraper/TheGamesDB/Lutris/IGDB metadata
         scraping, theme-index sync (library-core, shell-gamepad). Declared
         explicitly here now that no other droidtop module happens to carry
         it transitively. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Real wifi/cellular connectivity check for Handheld's own
         systemstatus theme element (EsDeThemeRenderer.kt). -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
      Requested during OnboardingActivity's flow, not implicitly. Real
      games/ROM files (including on an SD card, per docs/SPEC.md's games
      root note) need plain File-based reads that a SAF folder grant alone
      doesn't provide; droidtop isn't Play-Store-distributed, so requesting
      this directly is legitimate here the same way it's standard for
      file-manager and ROM-manager apps generally.
    -->
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <!--
      Real bug this fixes: dev.droidtop.library.NativeAppProvider's
      queryIntentActivities() call was returning an empty/filtered list on
      real devices, showing as an empty Apps section regardless of what's
      actually installed; confirmed real behavior of Android 11+'s
      package visibility restrictions (targetSdk 34 here), not a
      hypothetical concern: an app can't see other apps' launcher
      activities without either a matching queries declaration or this
      permission. Verified this is the real, working fix Daijishō itself
      uses for the identical need (its own decompiled manifest declares
      the same permission) rather than guessed. Legitimate here the same
      way it's legitimate for Daijishō: droidtop's own package genuinely
      ships a real HOME/LAUNCHER activity (shell-default's Launcher3
      fork), which is exactly the class of app Android grants this
      exemption to.
    -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" tools:ignore="QueryAllPackagesPermission" />

    <application
        android:name=".DroidtopApplication"
        android:label="@string/droidtop_app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:theme="@style/Theme.DroidTop"
        tools:replace="android:label,android:icon,android:roundIcon,android:name">

        <!--
          The real HOME/LAUNCHER entry point is :shell-default's own
          com.android.launcher3.Launcher (forked-in Murine Launcher — see
          shell-default/README.md), declared in that library module's own
          manifest and merged in here by AGP. This is deliberately NOT a
          second app-drawer icon: droidtop defaults to the normal Android
          launcher experience, and reaches Desktop/Handheld/Settings via
          the home screen's own back-button menu (see
          dev.droidtop.shell.standard.BackButtonMenu, patched into
          Launcher.onBackPressed()) launching this Activity by explicit
          Intent with an EXTRA_MODE extra — not a separate entry point a
          user would ever tap directly from the app drawer.
        -->
        <!--
          configChanges: without this, a real rotation (confirmed live via
          adb, WindowManager logged "relaunch") destroys and recreates this
          Activity from scratch, restarting Library's entire multi-provider
          scan from zero and discarding all Compose state (selectedGroup
          drill-down position, focus) every time. Compose already
          recomposes reactively off LocalConfiguration, so nothing here
          actually needs the recreation; declaring these dimensions handled
          keeps the single MainActivity instance (and its already-scanned
          Library state) alive across rotation/multi-window/keyboard
          changes instead.
        -->
        <activity
            android:name="dev.droidtop.app.MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|navigation" />

        <!--
          Started by dev.droidtop.shell.standard.OnboardingGate (:shell-default,
          via explicit component name; see that class's own doc comment for
          why not a typed Intent) on first launch only.
        -->
        <activity
            android:name="dev.droidtop.app.OnboardingActivity"
            android:exported="true" />

        <!--
          Explicit folder-to-console-system assignment. Started by
          :shell-gamepad's SettingsSection via explicit component name, same
          pattern as the SettingsActivity launches elsewhere.
        -->
        <activity
            android:name="dev.droidtop.app.ConsoleSystemsActivity"
            android:exported="true" />

        <!--
          Runs the primary container's host-bridge session (connect + present
          outputs) as a foreground service so the desktop survives the
          launcher Activity being backgrounded — see docs/SPEC.md.
        -->
        <service
            android:name="dev.droidtop.app.DesktopSessionService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Runs the primary Linux container powering droidtop's shared desktop" />
        </service>

        <!--
          Real bug this fixes: AmStartCommandToIntentConverter used to hand
          emulator apps a plain file:// URI (Uri.fromFile), which crashes
          with android.os.FileUriExposedException the moment the Intent
          crosses to another app on API 24+ (StrictMode) — confirmed live
          via adb logcat launching a real PSP game through PPSSPP. A
          FileProvider-issued content:// URI is the real, standard fix.
          root-path (not external-path) is deliberate: ROMs can live on a
          removable SD card, not just primary external storage — matches
          droidtop's own MANAGE_EXTERNAL_STORAGE (all-files) permission
          scope rather than external-path's narrower primary-volume-only
          coverage.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>
</manifest>
