<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Secondary-display presentation (second screen / external lapdock monitor) -->
    <uses-feature android:name="android.software.presentation" android:required="false" />

    <application
        android:label="@string/app_name"
        android:allowBackup="false"
        android:theme="@style/Theme.DroidTop">

        <activity
            android:name="dev.droidtop.app.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!--
              HOME + DEFAULT: lets the user pick DroidTop as their device's
              home screen (Android's standard "make this app a launcher"
              mechanism — a separate opt-in dialog, this doesn't force a
              replacement). The "Standard" shell (:shell-default) is what
              renders in that case; see MainActivity's own doc comment.
            -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!--
          Runs the primary container's host-bridge session (connect + present
          outputs) as a foreground service so the desktop survives the
          launcher Activity being backgrounded — see docs/SPEC.md.
        -->
        <service
            android:name="dev.droidtop.app.DesktopSessionService"
            android:exported="false"
            android:foregroundServiceType="specialUse" />

    </application>
</manifest>
