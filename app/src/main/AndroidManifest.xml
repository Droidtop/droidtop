<manifest
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Secondary-display presentation (second screen / external lapdock monitor) -->
    <uses-feature android:name="android.software.presentation" android:required="false" />

    <!-- DesktopSessionService (below) is a foreground service so the
         primary container's session survives the launching Activity being
         backgrounded. Both permissions are required for a "specialUse"
         foreground service on API 34+; POST_NOTIFICATIONS is required on
         API 33+ for the foreground-service notification itself to show. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Real outbound HTTP: ScreenScraper/TheGamesDB/Lutris/IGDB metadata
         scraping, theme-index sync (library-core, shell-gamepad). Declared
         explicitly here now that no other droidtop module happens to carry
         it transitively. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- In-app self-update (see app/.../update/AppSelfUpdate.kt): opening a
         PackageInstaller session for droidtop's own APK needs the
         install-unknown-apps grant; the second permission lets Android 12+
         skip the confirmation dialog only when the system itself judges
         droidtop eligible (its own installer of record). -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" />

    <!-- Real wifi/cellular connectivity check for Gaming's own
         systemstatus theme element (EsDeThemeRenderer.kt). -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Wi-Fi signal level for the status surfaces (Companion bar,
         Desktop tray, Gaming settings). SSID is deliberately never
         read: it would drag in fine-location. -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- Do Not Disturb control. Like WRITE_SETTINGS this is a special
         access the user grants on a system screen droidtop opens
         (SystemControls.dndGrantIntent) - one of the few real controls
         Android still lets an ordinary app own, so droidtop owns it. -->
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />
    <!-- Brightness control. Special access the user grants on a system
         screen droidtop opens (SystemControls.brightnessGrantIntent);
         every surface shows the grant action instead of failing silently
         while it is missing. -->
    <uses-permission android:name="android.permission.WRITE_SETTINGS" tools:ignore="ProtectedPermissions" />

    <!--
      Requested during OnboardingActivity's flow, not implicitly. Real
      games/ROM files (including on an SD card, per docs/SPEC.md's games
      root note) need plain File-based reads that a SAF folder grant alone
      doesn't provide; droidtop isn't Play-Store-distributed, so requesting
      this directly is legitimate here the same way it's standard for
      file-manager and ROM-manager apps generally.
    -->
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <!--
      minSdk is 26, and "All files access" only exists from API 30. On
      API 26-29 the equivalent capability IS the legacy runtime storage
      permission, so it is declared (capped at 29, where it stops being
      the mechanism) and OnboardingActivity's storage step requests it
      instead. Without this the step fired an API-30-only Settings
      intent on Android 9 and died with ActivityNotFoundException: a
      hard crash on every device below API 30, seen on the Android 9
      rig on 2026-09-11.
    -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />

    <!--
      Real bug this fixes: dev.droidtop.library.NativeAppProvider's
      queryIntentActivities() call was returning an empty/filtered list on
      real devices, showing as an empty Apps section regardless of what's
      actually installed; confirmed real behavior of Android 11+'s
      package visibility restrictions (targetSdk 34 here), not a
      hypothetical concern: an app can't see other apps' launcher
      activities without either a matching queries declaration or this
      permission. Verified this is the real, working fix Daijishō itself
      uses for the identical need (its own decompiled manifest declares
      the same permission) rather than guessed. Legitimate here the same
      way it's legitimate for Daijishō: droidtop's own package genuinely
      ships a real HOME/LAUNCHER activity (shell-default's Launcher3
      fork), which is exactly the class of app Android grants this
      exemption to.
    -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" tools:ignore="QueryAllPackagesPermission" />

    <application
        android:name=".DroidtopApplication"
        android:label="@string/droidtop_app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:theme="@style/Theme.DroidTop"
        tools:replace="android:label,android:icon,android:roundIcon,android:name">

        <!--
          The published build is not debuggable, which is what makes it fast,
          and also what stops adb from looking inside it. This lets the
          shell's profilers (simpleperf, method traces, dumpsys gfxinfo
          framestats) attach to the release build anyway, so performance is
          measured on the thing people actually run. API 29 and up; older
          releases ignore the element.
        -->
        <profileable android:shell="true" tools:targetApi="q" />

        <!--
          The real HOME/LAUNCHER entry point is :shell-default's own
          com.android.launcher3.Launcher (forked-in Murine Launcher - see
          shell-default/README.md), declared in that library module's own
          manifest and merged in here by AGP. From droidtop's own home
          screen, Desktop/Gaming/Settings are reached through its
          back-button menu (see dev.droidtop.shell.standard.BackButtonMenu,
          patched into Launcher.onBackPressed()) launching this Activity by
          explicit Intent with an EXTRA_MODE extra. droidtop's one drawer
          icon (LauncherGamesActivity, below) opens it too, in every
          launcher including droidtop's own.
        -->
        <!--
          configChanges: without this, a real rotation (confirmed live via
          adb, WindowManager logged "relaunch") destroys and recreates this
          Activity from scratch, restarting Library's entire multi-provider
          scan from zero and discarding all Compose state (selectedGroup
          drill-down position, focus) every time. Compose already
          recomposes reactively off LocalConfiguration, so nothing here
          actually needs the recreation; declaring these dimensions handled
          keeps the single MainActivity instance (and its already-scanned
          Library state) alive across rotation/multi-window/keyboard
          changes instead.
        -->
        <activity
            android:name="dev.droidtop.app.MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|navigation" />

        <!--
          Started by dev.droidtop.shell.standard.OnboardingGate (:shell-default,
          via explicit component name; see that class's own doc comment for
          why not a typed Intent) from every droidtop entry point while setup
          is unfinished. Every caller is inside this APK, so it is not
          exported: another app has no business walking the user into
          droidtop's setup screens.
        -->
        <activity
            android:name="dev.droidtop.app.OnboardingActivity"
            android:exported="false" />

        <!--
          The first-run tutorial (docs/SPEC.md 7b), shown when onboarding
          finishes and from Global settings' "Show the tutorial". Started
          only from inside this APK.
        -->
        <activity
            android:name="dev.droidtop.app.TutorialActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|navigation" />

        <!--
          Launching one library entry with no mode attached: how the
          Launcher (and adb, for checking it) reaches the shared launch
          resolution while Gaming is off. Exported so the launcher's own
          shortcut path and `am start` can reach it; it carries no
          permission-worthy capability of its own, and resolves only ids
          that droidtop's own scan produced.
        -->
        <activity
            android:name="dev.droidtop.app.GameLaunchActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="dev.droidtop.app.action.LAUNCH_GAME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!--
          "Continue playing" home-screen widget (docs/SPEC.md Launcher mode,
          "full computer" direction): the library's own recently-played
          games, placeable like any Nova/Apex widget from the Standard
          launcher's widget picker, no droidtop-specific picker UI needed,
          Launcher3's stock one already lists every app's widgets. Not
          exported beyond the widget-host contract (no exported="true": the
          platform delivers AppWidgetManager broadcasts to a receiver with
          no intent-filter category exposed for others to target).
        -->
        <receiver
            android:name="dev.droidtop.app.ContinuePlayingWidgetProvider"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_continue_playing_info" />
        </receiver>

        <!--
          droidtop's ONE drawer icon, in every launcher including droidtop's
          own (docs/SPEC.md 2c, "One droidtop icon"). It resumes unfinished
          onboarding, else opens Gaming or Desktop through MainActivity, else
          (both off) draws the library's games itself. The package's one
          MAIN/LAUNCHER activity, always enabled, which is also what lets a
          game be pinned to the home screen at all: the platform attributes
          a pinned shortcut to a launcher activity of its package and refuses
          one from a package that has none. The class keeps its old name
          because every pinned game names it. Its own task affinity: in the
          package's shared task, the icon brought back whatever droidtop
          screen was last left there, and B from the games grid or Cancel on
          the pin sheet dropped the person into it (rig, dq-shell2-01).
        -->
        <!--
          The app shortcut "Games" (res/xml/shortcuts.xml, a long press on
          the icon) opens the games grid whatever modes are on.
        -->
        <activity
            android:name="dev.droidtop.app.LauncherGamesActivity"
            android:exported="true"
            android:taskAffinity="dev.droidtop.app.games"
            android:label="@string/droidtop_app_name"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|navigation">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!--
          Explicit folder-to-console-system assignment. Started by
          :shell-gamepad's SettingsSection via explicit component name, same
          pattern as the SettingsActivity launches elsewhere. Started only
          from inside this APK, so not exported.
        -->
        <activity
            android:name="dev.droidtop.app.ConsoleSystemsActivity"
            android:exported="false" />

        <!--
          The widgets/ambient-info surface for whichever display the
          Gaming shell is NOT on (docs/SPEC.md section 4, Gaming-mode
          dual-screen roles). Started by MainActivity's role
          orchestration, never launched directly by the user.
        -->
        <activity
            android:name="dev.droidtop.app.CompanionActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|navigation" />

        <!--
          docs/SPEC.md section 3d's container/distro manager. The
          intent-filter action lets shells in other modules
          (:shell-desktop's taskbar) open it without a compile-time
          dependency on :app, same decoupling reason the SettingsActivity
          launches use component/action names elsewhere. Not exported:
          droidtop-internal surface.
        -->
        <activity
            android:name="dev.droidtop.app.ContainersActivity"
            android:exported="false">
            <intent-filter>
                <action android:name="dev.droidtop.app.action.CONTAINERS" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!--
          "Open with droidtop" for downloaded Windows programs, Linux packages
          and AppImages (docs/SPEC.md 4b). Disabled here and enabled by
          ModeStartup only while Desktop mode is on (ModePiece.DESKTOP_OPEN_WITH).
          By MIME type, and by extension for file managers that hand over a
          path with a generic type.
        -->
        <activity
            android:name="dev.droidtop.app.OpenWithActivity"
            android:exported="true"
            android:enabled="false"
            android:label="@string/droidtop_app_name"
            android:taskAffinity=""
            android:excludeFromRecents="true">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:mimeType="application/x-msdownload" />
                <data android:mimeType="application/x-ms-dos-executable" />
                <data android:mimeType="application/vnd.microsoft.portable-executable" />
                <data android:mimeType="application/x-msi" />
                <data android:mimeType="application/x-ms-installer" />
                <data android:mimeType="application/vnd.debian.binary-package" />
                <data android:mimeType="application/x-debian-package" />
                <data android:mimeType="application/x-rpm" />
                <data android:mimeType="application/x-redhat-package-manager" />
                <data android:mimeType="application/vnd.appimage" />
                <data android:mimeType="application/x-iso9660-appimage" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="file" android:mimeType="*/*" android:pathPattern=".*\\.exe" />
                <data android:scheme="file" android:mimeType="*/*" android:pathPattern=".*\\.EXE" />
                <data android:scheme="file" android:mimeType="*/*" android:pathPattern=".*\\.msi" />
                <data android:scheme="file" android:mimeType="*/*" android:pathPattern=".*\\.MSI" />
                <data android:scheme="file" android:mimeType="*/*" android:pathPattern=".*\\.deb" />
                <data android:scheme="file" android:mimeType="*/*" android:pathPattern=".*\\.rpm" />
                <data android:scheme="file" android:mimeType="*/*" android:pathPattern=".*\\.AppImage" />
                <data android:scheme="file" android:mimeType="*/*" android:pathPattern=".*\\.appimage" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" android:host="*" android:mimeType="*/*" android:pathPattern=".*\\.exe" />
                <data android:scheme="content" android:host="*" android:mimeType="*/*" android:pathPattern=".*\\.EXE" />
                <data android:scheme="content" android:host="*" android:mimeType="*/*" android:pathPattern=".*\\.msi" />
                <data android:scheme="content" android:host="*" android:mimeType="*/*" android:pathPattern=".*\\.MSI" />
                <data android:scheme="content" android:host="*" android:mimeType="*/*" android:pathPattern=".*\\.deb" />
                <data android:scheme="content" android:host="*" android:mimeType="*/*" android:pathPattern=".*\\.rpm" />
                <data android:scheme="content" android:host="*" android:mimeType="*/*" android:pathPattern=".*\\.AppImage" />
                <data android:scheme="content" android:host="*" android:mimeType="*/*" android:pathPattern=".*\\.appimage" />
            </intent-filter>
        </activity>

        <!--
          The device VPN a container serves (docs/SPEC.md 4a). Bound by the
          system only (BIND_VPN_SERVICE). Disabled here and enabled by
          ModeStartup only while Desktop mode is on (ModePiece.DESKTOP_VPN).
          Always-on starts it with no extras; it then uses VpnPrefs.
        -->
        <service
            android:name="dev.droidtop.app.vpn.DroidtopVpnService"
            android:permission="android.permission.BIND_VPN_SERVICE"
            android:exported="false"
            android:enabled="false">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
            <meta-data
                android:name="android.net.VpnService.SUPPORTS_ALWAYS_ON"
                android:value="true" />
        </service>

        <!--
          Runs the primary container's host-bridge session (connect + present
          outputs) as a foreground service so the desktop survives the
          launcher Activity being backgrounded - see docs/SPEC.md.
        -->
        <service
            android:name="dev.droidtop.app.DesktopSessionService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Runs the primary Linux container powering droidtop's shared desktop" />
        </service>

        <!--
          Real bug this fixes: AmStartCommandToIntentConverter used to hand
          emulator apps a plain file:// URI (Uri.fromFile), which crashes
          with android.os.FileUriExposedException the moment the Intent
          crosses to another app on API 24+ (StrictMode) - confirmed live
          via adb logcat launching a real PSP game through PPSSPP. A
          FileProvider-issued content:// URI is the real, standard fix.
          root-path (not external-path) is deliberate: ROMs can live on a
          removable SD card, not just primary external storage - matches
          droidtop's own MANAGE_EXTERNAL_STORAGE (all-files) permission
          scope rather than external-path's narrower primary-volume-only
          coverage.
        -->
        <!-- droidtop's own Steam sign-in + library surface over the
             vendored gamenative Steam service (its UI is deliberately
             not wired; see runtime-windows/src/main/AndroidManifest.xml). -->
        <activity
            android:name=".SteamLoginActivity"
            android:exported="false" />

        <!-- The PC surface's store half (docs/SPEC.md 7i, build-plan
             steps 5 to 7). All three host UI that :runtime-windows
             already compiles from the vendored gamenative tree rather
             than reimplementing it: the store app screen and the
             downloads queue, the three web-view store sign-ins, and the
             container configuration dialog. Started by explicit class
             name from the Gaming shell, which cannot depend on :app. -->
        <activity
            android:name=".PcStoreActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|navigation" />
        <activity
            android:name=".PcStoreSignInActivity"
            android:exported="false" />
        <activity
            android:name=".PcContainerConfigActivity"
            android:exported="false"
            android:theme="@style/Theme.DroidTop.Dark"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|navigation" />

        <!-- gamenative's own OAuth web views, the ones droidtop's store
             sign-in shim starts for a result. Declared here because
             :runtime-windows deliberately declares only the backbone
             components (see its own manifest) and these are UI droidtop
             does reach. Not exported: they are started from inside this
             app and carry an auth code back. -->
        <activity
            android:name="app.gamenative.ui.screen.auth.GOGOAuthActivity"
            android:exported="false" />
        <activity
            android:name="app.gamenative.ui.screen.auth.EpicOAuthActivity"
            android:exported="false" />
        <activity
            android:name="app.gamenative.ui.screen.auth.AmazonOAuthActivity"
            android:exported="false" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Registers :app's settings-catalog screens (console systems,
             platform CRUD, ROM folders, scraper credentials) into the
             process-wide SettingsScreenRegistry before any Activity runs;
             see SettingsCatalogInitProvider's own doc comment. -->
        <provider
            android:name="dev.droidtop.app.settings.SettingsCatalogInitProvider"
            android:authorities="${applicationId}.settingscataloginit"
            android:exported="false" />

        <!-- Feeds the Quick Menu's Notifications tab (runtime-common's
             NotificationsStore). Binds only after the user grants
             notification access on the system screen droidtop opens. -->
        <service
            android:name=".DroidtopNotificationListener"
            android:exported="false"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
        <!-- PackageInstaller reports the self-update verdict here. -->
        <receiver
            android:name="dev.droidtop.app.update.AppUpdateStatusReceiver"
            android:exported="false" />

        <!--
            The "update now" trigger (docs/SPEC.md 10b):
            adb shell am broadcast -a dev.droidtop.UPDATE_NOW -n dev.droidtop.app/.UpdateNowReceiver
            Exported on purpose, and guarded by a permission only the shell
            (what adb runs as), root and the system hold, so no ordinary app
            can drive droidtop's installer. That permission is the whole
            guard: a receiver cannot learn the sender's uid for an adb
            broadcast, so there is no uid re-check.
        -->
        <receiver
            android:name="dev.droidtop.app.UpdateNowReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="dev.droidtop.UPDATE_NOW" />
            </intent-filter>
        </receiver>

    </application>
</manifest>
