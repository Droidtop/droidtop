{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Droidtop/droidtop/docs/plugin-manifest.schema.json",
  "title": "droidtop plugin manifest (contract 1 and 2)",
  "description": "The signed manifest.json inside a .droidplugin bundle (docs/SPEC.md 12a, docs/plugin-api.md 1.2). PluginManifest.fromJson and PluginBundleInstaller are the enforcement; this schema is for authors and CI. Ids inside provides, permissions and subscribes that a build does not know are kept and listed as not supported, never refused, so they are plain strings here. Unknown top-level fields are ignored by droidtop.",
  "type": "object",
  "required": ["id", "origin", "kind", "contractVersion"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9_-]+\\.[a-z0-9._-]+$",
      "description": "<origin>.<name>, lowercase, namespaced under origin."
    },
    "origin": { "type": "string", "minLength": 1 },
    "label": { "type": "string" },
    "description": { "type": ["string", "null"] },
    "summary": { "type": "string", "maxLength": 80, "description": "One line saying what it is, shown under its name on its page and in the list (docs/plugin-api.md 1.2 \"Presentation\"). Longer is cut." },
    "publisher": { "type": "string", "maxLength": 60, "description": "Who makes it, as people know them; shown as \"Made by\"." },
    "homepage": { "type": "string", "pattern": "^https://", "description": "Its own page; anything but https is dropped." },
    "category": { "enum": ["sources", "emulators", "games", "tools", "system", "themes", "social", "other"], "description": "An unknown value is read as other." },
    "icon": { "type": "string", "pattern": "(?i)\\.(png|webp)$", "description": "A payload path of a square PNG or WebP; ignored unless it is a payload entry (so its hash was checked)." },
    "screenshots": { "type": "array", "maxItems": 6, "items": { "type": "string", "pattern": "(?i)\\.(png|webp)$" }, "description": "Payload paths of PNG or WebP screenshots; entries not in the payload are ignored." },
    "version": { "type": "string" },
    "kind": { "enum": ["native_bundle", "python", "flutter_embed"] },
    "contractVersion": { "type": "integer", "minimum": 2, "maximum": 3 },
    "minDroidtop": { "type": "string" },
    "capabilities": {
      "type": "array",
      "items": { "enum": ["acquire_content", "metadata_source", "library_action", "status_tile", "settings_rows", "app_status"] },
      "uniqueItems": true
    },
    "requestsRoot": { "type": "boolean" },
    "abis": { "type": "array", "items": { "enum": ["arm64-v8a", "x86_64", "armeabi-v7a", "x86"] }, "uniqueItems": true },
    "entryClass": { "type": ["string", "null"] },
    "runtimeVersion": { "type": ["string", "null"] },
    "payload": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "sha256"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    },
    "boundServiceTargets": { "type": "array", "items": { "type": "string" } },
    "subscribedEvents": { "type": "array", "items": { "type": "string" } },
    "provides": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["point"],
        "properties": {
          "point": { "type": "string", "minLength": 1 },
          "version": { "type": "integer", "minimum": 1 },
          "id": { "type": ["string", "null"] },
          "label": { "type": ["string", "null"] },
          "surfaces": { "type": "array", "items": { "type": "string" } },
          "target": { "type": "string" },
          "targets": { "type": "array", "items": { "enum": ["game", "app", "file", "folder", "system", "container", "window"] } },
          "systems": { "oneOf": [ { "type": "array", "items": { "type": "string" } }, { "const": "*" } ], "description": "ui.context_action: the systems the action is offered on. library.sources: the droidtop system ids the source serves (PC systems pc, windows, windows3x, windows9x, dos, linux, mac, macos are the PC library), or \"*\" (alone or in the list) for all; absent, empty or malformed keeps the old behaviour of serving every system." },
          "packages": { "type": "array", "items": { "type": "string" } },
          "job": { "type": "boolean" },
          "tab": { "enum": ["overview", "versions", "extras", "details"], "description": "ui.game_section only: the PC game page tab its rows go under; Extras when absent." },
          "entrypoint": { "type": "string", "minLength": 1, "description": "ui.main only (flutter_embed): the Dart function started on the hosted engine; annotate it @pragma('vm:entry-point')." },
          "library": { "type": "string", "description": "ui.main only: the library URI of entrypoint when it is not the root library." },
          "gamePackages": { "type": "array", "items": { "type": "string" }, "description": "ui.panel: the apps its Game rows are for. ui.quick_tile / ui.status_tile: the tile is shown only while one of these apps runs the game (docs/plugin-api.md C2)." },
          "whileGame": { "type": "boolean", "description": "ui.quick_tile / ui.status_tile: shown only while a game is running (docs/plugin-api.md C2)." }
        },
        "allOf": [
          { "if": { "properties": { "point": { "const": "ui.main" } }, "required": ["point"] }, "then": { "required": ["entrypoint"] } }
        ]
      }
    },
    "permissions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "reason": { "type": ["string", "null"] },
          "required": { "type": "boolean" },
          "domains": { "type": "array", "items": { "type": "string" } },
          "packages": { "type": "array", "items": { "type": "string" } },
          "paths": { "type": "array", "items": { "type": "string" }, "description": "files.shared.read / files.shared.write: folders relative to a storage volume, or \"*\" for all of it." },
          "scope": { "type": "string" },
          "signIn": { "type": "string", "description": "web.session only: the https sign-in page on one of its domains; droidtop's own Sign in opens it (docs/plugin-api.md G3)." },
          "expiredText": { "type": "array", "maxItems": 8, "items": { "type": "string", "minLength": 1, "maxLength": 200 }, "description": "web.session only: the sentences the site's page shows for a download link that has expired; droidtop then asks the source for a current link (docs/plugin-api.md G3, Droidtop/tracker#783)." }
        }
      }
    },
    "subscribes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["event"],
        "properties": { "event": { "type": "string" }, "version": { "type": "integer", "minimum": 1 } }
      }
    },
    "exports": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["api"],
        "properties": {
          "api": { "type": "string" },
          "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
          "attributes": { "type": "object" },
          "ops": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["op", "permission"],
              "properties": { "op": { "type": "string" }, "permission": { "type": "string" }, "job": { "type": "boolean" } }
            }
          },
          "permissions": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id"],
              "properties": { "id": { "type": "string" }, "risk": { "enum": ["low", "medium", "high", "critical"] }, "label": { "type": "string" } }
            }
          }
        }
      }
    },
    "requires": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["api"],
        "properties": {
          "api": { "type": "string" },
          "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
          "optional": { "type": "boolean" },
          "minLevel": { "type": ["string", "null"] },
          "reason": { "type": ["string", "null"] }
        }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "contractVersion": { "const": 1 } } },
      "then": { "required": ["capabilities"], "properties": { "capabilities": { "minItems": 1 } } }
    },
    {
      "if": { "properties": { "kind": { "const": "native_bundle" } } },
      "then": { "required": ["entryClass"], "properties": { "entryClass": { "type": "string", "minLength": 1 } } }
    },
    {
      "if": { "properties": { "kind": { "const": "flutter_embed" } } },
      "then": { "required": ["runtimeVersion"], "properties": { "runtimeVersion": { "type": "string", "minLength": 1 } } }
    }
  ]
}
